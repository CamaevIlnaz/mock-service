generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  user
}

enum HttpMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
}

enum MockResponseType {
  INLINE_JSON
  FILE
}

model User {
  id           Int          @id @default(autoincrement())
  login        String       @unique
  passwordHash String       @map("password_hash")
  firstName    String       @map("first_name")
  role         Role         @default(user)
  avatarPath   String?      @map("avatar_path")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  mockServers  MockServer[]

  @@map("users")
}

model Stand {
  id          Int          @id @default(autoincrement())
  code        String       @unique
  name        String
  domain      String
  basePath    String       @map("base_path")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  mockServers MockServer[]

  @@map("stands")
}

model MockServer {
  id              Int      @id @default(autoincrement())
  name            String
  sortOrder       Int      @default(0) @map("sort_order")
  standCode       String   @map("stand_code")
  userId          Int      @map("user_id")
  connectionToken String   @unique @map("connection_token")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  stand         Stand              @relation(fields: [standCode], references: [code], onDelete: Restrict)
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  rules         MockRule[]
  responseFiles MockResponseFile[]

  @@index([userId])
  @@index([userId, sortOrder])
  @@map("mock_servers")
}

model MockRule {
  id              Int              @id @default(autoincrement())
  mockServerId    Int              @map("mock_server_id")
  name            String
  method          HttpMethod
  urlMask         String           @map("url_mask") @db.VarChar(1000)
  isEnabled       Boolean          @default(true) @map("is_enabled")
  priority        Int              @default(0)
  statusCode      Int              @default(200) @map("status_code")
  delayMs         Int              @default(0) @map("delay_ms")
  responseType    MockResponseType @default(INLINE_JSON) @map("response_type")
  responseBody    Json?            @map("response_body")
  responseFileId  Int?             @map("response_file_id")
  responseHeaders Json?            @map("response_headers")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  mockServer   MockServer         @relation(fields: [mockServerId], references: [id], onDelete: Cascade)
  responseFile MockResponseFile?  @relation(fields: [responseFileId], references: [id], onDelete: SetNull)

  @@index([mockServerId, priority])
  @@index([responseFileId])
  @@map("mock_rules")
}

model MockResponseFile {
  id           Int      @id @default(autoincrement())
  mockServerId Int      @map("mock_server_id")
  originalName String   @map("original_name")
  mimeType     String   @map("mime_type")
  sizeBytes    Int      @map("size_bytes")
  storagePath  String   @map("storage_path")
  createdAt    DateTime @default(now()) @map("created_at")

  mockServer MockServer @relation(fields: [mockServerId], references: [id], onDelete: Cascade)
  rules      MockRule[]

  @@index([mockServerId])
  @@map("mock_response_files")
}
